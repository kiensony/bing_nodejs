    "ensureStreakProtection": true,
    "autoClaimPunchcardRewards": true,
    "continueOnBotWarning": true,
    "skipNonPointTasks": false,
    "accountDelay": {
        "min": "30sec",
        "max": "1min"
    },
    "taskDelay": {
        "min": "12sec",
        "max": "20sec"
    },
    "workers": {
        "doDailySet": true,
        "doClaimBonusPoints": true,
        "doMorePromotions": true,
        "doPunchCards": true,
        "doAppPromotions": true,
        "doDesktopSearch": true,
        "doMobileSearch": true,
        "doBonusSearches": true,
        "doDailyCheckIn": true,
        "doReadToEarn": true,
        "doActivateSearchPerk": true,
        "doVisualSearch": true
    },
    "activities": {
        "urlReward": true,
        "searchOnBing": true
    },
    "searchOnBingLocalQueries": false,
    "globalTimeout": "30sec",
    "searchSettings": {
        "maxSearchOnBingAttempts": 3,
        "scrollRandomResults": true,
        "clickRandomResults": true,
        "runOnZeroPoints": false,
        "maxBonusSearches": 110,
        "parallelSearching": true,
        "clusterSearch": true,
        "useAccountLocale": true,
        "queryEngines": [
            "google",
            "local",
            "wikipedia",
            "rss.googleNews"
        ],
        "searchResultVisitTime": "12sec",
        "searchDelay": {
            "min": "12sec",
            "max": "30sec"
        },
        "readDelay": {
            "min": "20s",
            "max": "30sec"
        }
    },
    "experimental": {
        "blockMedia": false,
        "edgeBrowsing": true,
        "browserSearchApiReport": false
    },
    "debugLogs": false,
    "consoleLogFilter": {
